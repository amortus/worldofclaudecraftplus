# Content-hashed bundles: cache for 1 year (immutable)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Audio and model files are also content-hashed via the media manifest
/audio/*
  Cache-Control: public, max-age=31536000, immutable
/media/*
  Cache-Control: public, max-age=31536000, immutable
/models/*
  Cache-Control: public, max-age=31536000, immutable
/textures/*
  Cache-Control: public, max-age=31536000, immutable

# HDR environment maps + backdrop WebPs — large static files, versioned by filename
/env/*
  Cache-Control: public, max-age=31536000, immutable

# VFX sprite sheets — static, never change between deploys
/vfx/*
  Cache-Control: public, max-age=31536000, immutable

# Everything else: no-cache (revalidate on each visit)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
